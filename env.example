# RAG 系統環境變數配置範例
# 複製此文件為 .env 並修改相應的值

# 時區配置
TZ=Asia/Taipei

# Ollama 配置
OLLAMA_API_HOST=http://ollama:11434/

# 後端服務配置
BACKEND_PORT=8080

# 模型目錄配置
HF_HOME=/backend/models


# 日誌配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 開發環境配置
DEBUG=false
ENVIRONMENT=develop

# 安全配置
JWT_SECRET_KEY=your-secret-key-change-this-in-production
SESSION_TIMEOUT=3600
COOKIE_SECURE=false

# 資料庫設定
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=rag_db
DB_USER=rag_user
DB_PASSWORD=rag_password_2024
DB_ROOT_PASSWORD=root_password_2024

# 向量資料庫設定
FAISS_DIR=/backend/faiss_data

# GPU設定
NVIDIA_GPU_COUNT=0